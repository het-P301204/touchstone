# TOUCHSTONE configuration. Copy to .env (never commit it) or set in the environment.
# Every variable is optional; the defaults run the API on loopback in DEMO mode,
# with administration disabled and no network collection.
# The server validates all of these at start and exits with a message naming
# any variable that is invalid.

# --- Server -------------------------------------------------------------------
# Interface to bind. Loopback by default; set 0.0.0.0 only behind a reverse proxy.
HOST=127.0.0.1
# Port to listen on.
PORT=8787
# NODE_ENV=production has the same effect as the --production flag: the API also
# serves the built web app (apps/web/dist) on the same origin, and sends HSTS.
# NODE_ENV=production

# --- Data ---------------------------------------------------------------------
# Published bundle the API serves (index.json, runs/, inputs/, history.json,
# disputes.json, notebook.json). Built by `npm run demo:build`. Loaded once at
# start; reads never recompute a run.
TOUCHSTONE_DATA_DIR=apps/web/public/data
# SQLite database for disputes, the research notebook and refresh jobs.
# Use :memory: for an ephemeral server (tests, CI).
TOUCHSTONE_DB=.data/touchstone.db
# Built web app served in --production.
TOUCHSTONE_WEB_DIST=apps/web/dist

# --- Refresh mode -------------------------------------------------------------
# demo (default): POST /api/refresh replays the bundled demo snapshot from
#   TOUCHSTONE_DEMO_FIXTURES through the pipeline. It makes NO network calls.
# live: POST /api/refresh runs the live collector over TOUCHSTONE_LIVE_REGISTRY
#   (outbound HTTPS to public sources through the SSRF-safe fetcher). Live
#   snapshots are written to TOUCHSTONE_LIVE_OUT and never published automatically.
TOUCHSTONE_MODE=demo
TOUCHSTONE_DEMO_FIXTURES=fixtures/demo
# Required when TOUCHSTONE_MODE=live: the vendor registry JSON to collect for.
# TOUCHSTONE_LIVE_REGISTRY=fixtures/live/registry.example.json
TOUCHSTONE_LIVE_OUT=.touchstone/live

# --- Administration -----------------------------------------------------------
# Bearer token for POST /api/refresh, POST /api/disputes/:id/transition and
# POST /api/notebook (Authorization: Bearer <token>, compared in constant time).
# At least 24 characters. When unset, those endpoints answer 403 "administration disabled".
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# TOUCHSTONE_ADMIN_TOKEN=

# --- Network edge -------------------------------------------------------------
# true only when exactly one trusted reverse proxy sits in front of the API: rate
# limits then key on the right-most X-Forwarded-For entry (the one the proxy
# appended). Otherwise the socket address is used and X-Forwarded-For is ignored.
TOUCHSTONE_TRUST_PROXY=false
# Comma-separated origins that get CORS headers (e.g. https://research.example.org).
# Empty (the default) means CORS is off: the web app is served from the same origin.
TOUCHSTONE_CORS_ORIGINS=
# Host header values accepted (DNS-rebinding protection). Defaults to the loopback
# names when HOST is loopback. REQUIRED when HOST is not loopback (e.g. 0.0.0.0):
# the server refuses to start without it. "*" accepts any Host explicitly and logs
# a warning at start; use it only behind a proxy that validates Host.
# TOUCHSTONE_ALLOWED_HOSTS=touchstone.example.org,localhost

# --- Limits -------------------------------------------------------------------
# Per-client limits key IPv4 clients by address and IPv6 clients by their /64
# (IPv4-mapped IPv6 counts as the IPv4 address).
# All API requests per client address per minute.
TOUCHSTONE_RATE_LIMIT_PER_MINUTE=300
# Public dispute submissions per client address per hour.
TOUCHSTONE_DISPUTE_RATE_LIMIT_PER_HOUR=10
# Run reproductions (POST /api/runs/:id/reproduce, CPU-bound) per client address per hour.
TOUCHSTONE_REPRODUCE_RATE_LIMIT_PER_HOUR=30
# Server-wide ceilings per hour, whatever the client address: disputes accepted,
# and reproductions started. Beyond them the API answers 429 RATE_LIMITED_GLOBAL.
TOUCHSTONE_DISPUTE_GLOBAL_LIMIT_PER_HOUR=200
TOUCHSTONE_REPRODUCE_GLOBAL_LIMIT_PER_HOUR=120
# Reproductions run one at a time; this many may wait behind the one in flight.
# When the queue is full the API answers 429 REPRODUCE_BUSY (0 = no queue).
TOUCHSTONE_REPRODUCE_QUEUE_LIMIT=4
# Request body cap in bytes, enforced before the body is read (1024 - 1048576).
TOUCHSTONE_MAX_BODY_BYTES=32768

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error | silent. Logs are JSON lines; bodies, headers and
# tokens are never logged.
TOUCHSTONE_LOG_LEVEL=info

# --- Smoke test (scripts/smoke.ts only) ----------------------------------------
# true: skip the checks that expect the web app HTML (API-only deployments).
TOUCHSTONE_SMOKE_API_ONLY=false
# true: skip the dispute POST round trip (leave the dispute log untouched).
TOUCHSTONE_SMOKE_NO_WRITE=false

# --- CLI ----------------------------------------------------------------------
# NO_COLOR=1 disables colour in `touchstone` output (FORCE_COLOR=1 forces it).
